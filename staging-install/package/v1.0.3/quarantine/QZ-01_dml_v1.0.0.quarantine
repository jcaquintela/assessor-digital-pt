--Q| -- [reparo] S2-01_v2_schema_part1.sql:4066 (update)
--Q| WITH explicit_answers AS (
--Q|   SELECT DISTINCT ON (n.user_id, n.subject_id)
--Q|     n.user_id,
--Q|     n.subject_id,
--Q|     CASE
--Q|       WHEN lower(trim(m.content)) IN ('sim', 'sim!', 'ok', 'pode ser', 'claro') THEN 'yes'
--Q|       WHEN lower(trim(m.content)) IN ('não', 'nao', 'não!', 'nao!') THEN 'no'
--Q|     END AS answer,
--Q|     m.created_at AS answered_at
--Q|   FROM public.assessor_nudges n
--Q|   JOIN public.assessor_messages m
--Q|     ON m.user_id = n.user_id
--Q|    AND m.role = 'user'
--Q|    AND m.created_at >= n.sent_at
--Q|    AND m.created_at <= n.sent_at + interval '15 minutes'
--Q|   WHERE n.kind = 'property_missing_docs'
--Q|     AND n.sent_at IS NOT NULL
--Q|     AND lower(trim(m.content)) IN ('sim', 'sim!', 'ok', 'pode ser', 'claro', 'não', 'nao', 'não!', 'nao!')
--Q|   ORDER BY n.user_id, n.subject_id, m.created_at DESC
--Q| )
--Q| UPDATE public.assessor_nudges n
--Q| SET status = 'resolved',
--Q|     outcome = a.answer,
--Q|     outcome_at = a.answered_at,
--Q|     updated_at = now()
--Q| FROM explicit_answers a
--Q| WHERE n.user_id = a.user_id
--Q|   AND n.subject_id = a.subject_id
--Q|   AND n.kind = 'property_missing_docs'
--Q|   AND n.outcome_at IS NULL;
