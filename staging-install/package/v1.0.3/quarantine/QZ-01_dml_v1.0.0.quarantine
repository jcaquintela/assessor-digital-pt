--Q| -- [reparo] S2-01_v2_schema_part1.sql:3307 (update)
--Q| WITH q AS (
--Q|   SELECT s.id, t.user_id, t.channel, t.input_content, t.created_at
--Q|   FROM public.assessor_quality_scores s JOIN public.assessor_reasoning_traces t ON t.id=s.trace_id
--Q| ), ctx AS (
--Q|   SELECT q.*, p.content prev_msg, p.created_at prev_at,
--Q|     (SELECT m.content FROM public.assessor_messages m WHERE m.user_id=q.user_id AND m.channel=q.channel AND m.role='assistant' AND m.created_at<q.created_at ORDER BY m.created_at DESC LIMIT 1) last_reply
--Q|   FROM q LEFT JOIN LATERAL (
--Q|     SELECT content, created_at FROM (
--Q|       SELECT m.content, m.created_at, row_number() OVER (ORDER BY m.created_at DESC) rn
--Q|       FROM public.assessor_messages m
--Q|       WHERE m.user_id=q.user_id AND m.channel=q.channel AND m.role='user' AND m.created_at<q.created_at
--Q|       ORDER BY m.created_at DESC LIMIT 3) x
--Q|     WHERE rn = (SELECT CASE WHEN EXISTS (
--Q|         SELECT 1 FROM public.assessor_messages m2 WHERE m2.user_id=q.user_id AND m2.channel=q.channel AND m2.role='user'
--Q|           AND m2.created_at<q.created_at AND btrim(m2.content)=btrim(q.input_content)
--Q|           AND m2.created_at=(SELECT max(m3.created_at) FROM public.assessor_messages m3 WHERE m3.user_id=q.user_id AND m3.channel=q.channel AND m3.role='user' AND m3.created_at<q.created_at)
--Q|       ) THEN 2 ELSE 1 END) LIMIT 1) p ON true
--Q| ), sim AS (
--Q|   SELECT c.*, EXTRACT(epoch FROM (c.created_at-c.prev_at)) dt,
--Q|    COALESCE((SELECT cardinality(ARRAY(SELECT unnest(z.a) INTERSECT SELECT unnest(z.b)))::numeric/NULLIF(cardinality(ARRAY(SELECT unnest(z.a) UNION SELECT unnest(z.b))),0)
--Q|     FROM (SELECT
--Q|      ARRAY(SELECT DISTINCT w FROM unnest(regexp_split_to_array(lower(regexp_replace(translate(c.input_content,'áàâãéêíóôõúçÁÀÂÃÉÊÍÓÔÕÚÇ','aaaaeeioooucAAAAEEIOOOUC'),'[^a-zA-Z0-9 ]',' ','g')),'\s+')) w WHERE length(w)>1 AND w NOT IN ('de','da','do','das','dos','um','uma','que','para','por','com','no','na','nos','nas','em','ao','as','os','se','ou')) a,
--Q|      ARRAY(SELECT DISTINCT w FROM unnest(regexp_split_to_array(lower(regexp_replace(translate(COALESCE(c.prev_msg,''),'áàâãéêíóôõúçÁÀÂÃÉÊÍÓÔÕÚÇ','aaaaeeioooucAAAAEEIOOOUC'),'[^a-zA-Z0-9 ]',' ','g')),'\s+')) w WHERE length(w)>1 AND w NOT IN ('de','da','do','das','dos','um','uma','que','para','por','com','no','na','nos','nas','em','ao','as','os','se','ou')) b) z),0) jac
--Q|   FROM ctx c
--Q| ), cls AS (
--Q|   SELECT id,
--Q|    CASE WHEN prev_msg IS NULL OR dt IS NULL OR dt<0 OR dt>600 THEN false
--Q|         WHEN jac>=0.9 THEN true
--Q|         WHEN last_reply ~ '\?\s*$' THEN false
--Q|         WHEN dt>60 THEN false
--Q|         WHEN jac>=0.6 OR input_content ~* '(nao e|nao era|errado|erraste|quis dizer|queria dizer|afinal|alias|corrige|troca|substitui)' THEN true
--Q|         ELSE false END novo FROM sim)
--Q| UPDATE public.assessor_quality_scores s
--Q| SET reformulated = c.novo,
--Q|     score = round((
--Q|       (CASE WHEN s.understood_first_try THEN 1 ELSE 0 END)
--Q|       + (CASE WHEN c.novo THEN 0 ELSE 1 END)
--Q|       + (CASE WHEN s.executed_successfully THEN 1 ELSE 0 END)
--Q|       + (CASE WHEN s.human_tone THEN 1 ELSE 0 END)
--Q|     )::numeric / NULLIF((
--Q|       (CASE WHEN s.understood_first_try IS NULL THEN 0 ELSE 1 END)
--Q|       + 1
--Q|       + (CASE WHEN s.executed_successfully IS NULL THEN 0 ELSE 1 END)
--Q|       + (CASE WHEN s.human_tone IS NULL THEN 0 ELSE 1 END)
--Q|     ),0), 3)
--Q| FROM cls c WHERE c.id = s.id AND s.reformulated IS DISTINCT FROM c.novo;
