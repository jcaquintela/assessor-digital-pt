--Q| -- [interruptor] S2-99_staging_safety_checks.sql:8 (update)
--Q| UPDATE public.feature_flags
--Q|    SET enabled_globally = false, enabled_plans = '{}'::text[], rollout_percentage = 0, updated_by = NULL
--Q|  WHERE enabled_globally OR rollout_percentage <> 0 OR cardinality(enabled_plans) > 0 OR updated_by IS NOT NULL;
--Q|
--Q| -- [verificacao] S2-99_staging_safety_checks.sql:12 (do)
--Q| DO $$
--Q| BEGIN
--Q|   IF EXISTS (SELECT 1 FROM public.feature_flags
--Q|              WHERE enabled_globally OR rollout_percentage <> 0 OR cardinality(enabled_plans) > 0) THEN
--Q|     RAISE EXCEPTION 'staging: há interruptores ligados';
--Q|   END IF;
--Q|   IF EXISTS (SELECT 1 FROM public.feature_flag_users) THEN
--Q|     RAISE EXCEPTION 'staging: há ativações individuais de interruptores';
--Q|   END IF;
--Q|   IF EXISTS (SELECT 1 FROM public.pilots) OR EXISTS (SELECT 1 FROM public.pilot_participants) THEN
--Q|     RAISE EXCEPTION 'staging: há pilotos ou participantes (devem vir só dos dados sintéticos, passo S5)';
--Q|   END IF;
--Q|   IF EXISTS (SELECT 1 FROM public.user_roles WHERE role IN ('super_admin', 'support_admin')) THEN
--Q|     RAISE EXCEPTION 'staging: há administradores V2 atribuídos pela montagem';
--Q|   END IF;
--Q|   IF NOT EXISTS (SELECT 1 FROM pg_enum e JOIN pg_type t ON t.oid = e.enumtypid
--Q|                  WHERE t.typname = 'app_role' AND e.enumlabel = 'admin')
--Q|      OR NOT EXISTS (SELECT 1 FROM pg_enum e JOIN pg_type t ON t.oid = e.enumtypid
--Q|                  WHERE t.typname = 'app_role' AND e.enumlabel = 'tester') THEN
--Q|     RAISE EXCEPTION 'staging: os papéis admin/tester do staging desapareceram';
--Q|   END IF;
--Q|   IF to_regprocedure('public.has_staging_access(uuid)') IS NULL THEN
--Q|     RAISE EXCEPTION 'staging: has_staging_access desapareceu';
--Q|   END IF;
--Q| END $$;
