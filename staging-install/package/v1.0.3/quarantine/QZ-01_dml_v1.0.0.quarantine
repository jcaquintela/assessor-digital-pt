--Q| WHERE uf.related_resource_type IS NOT NULL
--Q|   AND uf.related_resource_id IS NOT NULL
--Q|   AND uf.user_id IS NOT NULL
--Q|   AND CASE uf.related_resource_type
--Q|     WHEN 'people' THEN 'person'
--Q|     WHEN 'person' THEN 'person'
--Q|     WHEN 'properties' THEN 'property'
--Q|     WHEN 'property' THEN 'property'
--Q|     WHEN 'opportunities' THEN 'opportunity'
--Q|     WHEN 'opportunity' THEN 'opportunity'
--Q|     WHEN 'follow_ups' THEN 'follow_up'
--Q|     WHEN 'follow_up' THEN 'follow_up'
--Q|     WHEN 'interactions' THEN 'interaction'
--Q|     WHEN 'interaction' THEN 'interaction'
--Q|     WHEN 'miscellaneous_items' THEN 'miscellaneous'
--Q|     WHEN 'miscellaneous' THEN 'miscellaneous'
--Q|     WHEN 'prospecting_leads' THEN 'prospecting_lead'
--Q|     WHEN 'prospecting_lead' THEN 'prospecting_lead'
--Q|     ELSE NULL
