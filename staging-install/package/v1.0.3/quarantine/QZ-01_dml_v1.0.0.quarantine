--Q| -- [reparo] S2-01_v2_schema_part1.sql:2960 (update)
--Q| UPDATE public.properties p
--Q| SET category_id = pc.id
--Q| FROM public.entity_tags et
--Q| JOIN public.tags t ON t.id = et.tag_id
--Q| JOIN public.property_categories pc ON lower(pc.name) = lower(t.name)
--Q| WHERE et.entity_type = 'property' AND et.entity_id = p.id
--Q|   AND pc.user_id = p.user_id AND p.category_id IS NULL;
--Q|
--Q| -- [reparo] S2-01_v2_schema_part1.sql:2969 (update)
--Q| UPDATE public.properties p
--Q| SET notes = trim(both E'\n' from coalesce(p.notes,'') || E'\n' || 'Etiquetas anteriores: ' || x.lista)
--Q| FROM (
--Q|   SELECT et.entity_id, string_agg(t.name, ', ' ORDER BY t.name) AS lista
--Q|   FROM public.entity_tags et
--Q|   JOIN public.tags t ON t.id = et.tag_id
--Q|   JOIN public.properties pr ON pr.id = et.entity_id
--Q|   LEFT JOIN public.property_categories pc ON pc.user_id = pr.user_id AND lower(pc.name) = lower(t.name)
--Q|   WHERE et.entity_type = 'property' AND (pc.id IS NULL OR pr.category_id IS DISTINCT FROM pc.id)
--Q|   GROUP BY et.entity_id
--Q| ) x
--Q| WHERE x.entity_id = p.id;
--Q|
--Q| -- [reparo] S2-01_v2_schema_part1.sql:2983 (delete)
--Q| DELETE FROM public.entity_tags WHERE entity_type = 'property';
--Q|
