--Q|       when raw ~* '(not_found|invalid_args|tool_failed|error|_rls|falha)' or raw like '%:%' then 'Percebi o pedido, mas não consegui concluir a ação.'
--Q|       else 'Guardei aqui para não se perder — diz-me o que fazer com isto.'
--Q|     end as pt
